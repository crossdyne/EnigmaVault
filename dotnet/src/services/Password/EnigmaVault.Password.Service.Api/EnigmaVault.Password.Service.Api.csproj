    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\contracts\Shared.Contracts\Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\observability\Shared.Logging\Shared.Logging.csproj" />
    <ProjectReference Include="..\EnigmaVault.Password.Service.Application\EnigmaVault.Password.Service.Application.csproj" />
    <ProjectReference Include="..\EnigmaVault.Password.Service.Infrastructure\EnigmaVault.Password.Service.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>EnigmaVault.Password.Service.Api</RootNamespace>
    <AssemblyName>EnigmaVault.Password.Service.Api</AssemblyName>
  </PropertyGroup>

</Project>
